  {
    "id": "opencode",
    "name": "OpenCode",
    "icon": {
      "brand": "opencode"
    },
    "command": "opencode",
    "pitch": "Open source and works with any model provider. tab runs it over the Agent Client Protocol.",
    "capabilities": {
      "strict": true,
      "permission_modes": [],
      "budget_cap": false
    },
    "model_hint": "provider/model, e.g. anthropic/claude-sonnet-5-5",
    "small_model": null,
    "list_models": {
      "args": [
        "models"
      ],
      "format": "provider_slash_model_lines"
    },
    "families": {
      "fast": "anthropic/claude-haiku-5-5",
      "balanced": "anthropic/claude-sonnet-5-5",
      "deep": "anthropic/claude-opus-5-5"
    },
    "install": {
      "npm": "opencode-ai",
      "unix": "curl -fsSL https://opencode.ai/install | bash",
      "windows": null
    },
    "upgrade": {
      "winget": null,
      "npm": "npm install -g opencode-ai@latest",
      "brew": "brew upgrade opencode",
      "native": "opencode upgrade"
    },
    "instruction_files": ["AGENTS.md", "CLAUDE.md"],
    "strict_instruction_files": ["AGENTS.md"],
    "bin_dirs": [
      ".opencode/bin",
      ".local/bin"
    ],
    "acp": {
      "command": null,
      "args": [
        "acp"
      ],
      "env": {},
      "strict_args": [],
      "strict_env": {
        "OPENCODE_DISABLE_CLAUDE_CODE": "1"
      },
      "mcp_tool_name": "{server}_{tool}",
      "adapter": null,
      "preview": false,
      "steering": "prompt"
    }
  },
  {
    "id": "codex",
    "name": "Codex",
    "icon": {
      "brand": null,
      "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><rect x=\"1.5\" y=\"3\" width=\"21\" height=\"18\" rx=\"4.5\" fill=\"none\" stroke=\"#8b8b93\" stroke-width=\"2\"/><path d=\"M6.5 9l3.5 3-3.5 3\" fill=\"none\" stroke=\"#8b8b93\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M12.5 15.5h5\" stroke=\"#8b8b93\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>"
    },
    "command": "codex",
    "pitch": "OpenAI's coding agent. tab runs the Codex CLI with your ChatGPT sign-in or API key and streams each turn.",
    "capabilities": {
      "strict": true,
      "permission_modes": [],
      "budget_cap": false
    },
    "model_hint": "e.g. gpt-6-sol",
    "small_model": null,
    "list_models": {
      "args": [
        "app-server"
      ],
      "stdin": [
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"clientInfo\":{\"name\":\"tab\",\"version\":\"0\"}}}",
        "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\"}",
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"model/list\",\"params\":{}}"
      ],
      "format": "codex_model_list"
    },
    "families": {
      "fast": "gpt-6-luna",
      "balanced": "gpt-6-sol",
      "deep": "gpt-6.1-sol"
    },
    "install": {
      "npm": "@openai/codex",
      "unix": null,
      "windows": null
    },
    "upgrade": {
      "winget": null,
      "npm": "npm install -g @openai/codex@latest",
      "brew": "brew upgrade codex",
      "native": null
    },
    "instruction_files": ["AGENTS.md"],
    "bin_dirs": [
      ".local/bin",
      ".codex/bin"
    ],
    "acp": {
      "command": "codex-acp",
      "args": [],
      "env": {},
      "strict_args": [],
      "strict_env": {},
      "mcp_tool_name": "mcp.{server}.{tool}",
      "steering": "extension",
      "preview": false,
      "adapter": {
        "npm": "@agentclientprotocol/codex-acp",
        "version": "2.6.0",
        "repo": "https://github.com/agentclientprotocol/codex-acp",
        "license": "Apache-2.0"
      }
    }
  },
