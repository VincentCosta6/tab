[
  {
    "id": "claude_code",
    "name": "Claude Code",
    "icon": {
      "brand": "claude"
    },
    "command": "claude",
    "pitch": "If you use Claude, tab drives the official Claude Code CLI with your own login, so your usage stays within Anthropic's terms.",
    "capabilities": {
      "strict": true,
      "permission_modes": [
        {
          "value": "default",
          "label": "Ask first",
          "help": "Asks before edits and commands"
        },
        {
          "value": "acceptEdits",
          "label": "Accept edits",
          "help": "Edits files freely, asks before commands"
        },
        {
          "value": "auto",
          "label": "Auto",
          "help": "Claude decides what's safe and asks about the rest"
        },
        {
          "value": "plan",
          "label": "Plan only",
          "help": "Reads and plans, changes nothing"
        }
      ],
      "budget_cap": true
    },
    "model_hint": "e.g. sonnet or opus",
    "small_model": "haiku",
    "list_models": {
      "args": [
        "-p",
        "--input-format",
        "stream-json",
        "--output-format",
        "stream-json",
        "--verbose"
      ],
      "stdin": [
        "{\"type\":\"control_request\",\"request_id\":\"tab_models\",\"request\":{\"subtype\":\"initialize\"}}"
      ],
      "format": "claude_initialize"
    },
    "install": {
      "npm": "@anthropic-ai/claude-code",
      "unix": "curl -fsSL https://claude.ai/install.sh | bash",
      "windows": "irm https://claude.ai/install.ps1 | iex"
    },
    "upgrade": {
      "winget": "winget upgrade Anthropic.ClaudeCode",
      "npm": "npm install -g @anthropic-ai/claude-code@latest",
      "brew": "brew upgrade --cask claude-code",
      "native": "claude update"
    },
    "bin_dirs": [
      ".local/bin",
      ".claude/local"
    ]
  },
  {
    "id": "opencode",
    "name": "OpenCode",
    "icon": {
      "brand": "opencode"
    },
    "command": "opencode",
    "pitch": "Open source and works with any model provider. tab runs it over the Agent Client Protocol.",
    "capabilities": {
      "strict": true,
      "permission_modes": [],
      "budget_cap": false
    },
    "model_hint": "provider/model, e.g. anthropic/claude-sonnet-5-5",
    "small_model": null,
    "list_models": {
      "args": [
        "models"
      ],
      "format": "provider_slash_model_lines"
    },
    "install": {
      "npm": "opencode-ai",
      "unix": "curl -fsSL https://opencode.ai/install | bash",
      "windows": null
    },
    "upgrade": {
      "winget": null,
      "npm": "npm install -g opencode-ai@latest",
      "brew": "brew upgrade opencode",
      "native": "opencode upgrade"
    },
    "bin_dirs": [
      ".opencode/bin",
      ".local/bin"
    ],
    "acp": {
      "command": null,
      "args": [
        "acp"
      ],
      "env": {},
      "strict_args": [],
      "strict_env": {
        "OPENCODE_DISABLE_CLAUDE_CODE": "1"
      },
      "mcp_tool_name": "{server}_{tool}",
      "adapter": null,
      "preview": false
    }
  },
  {
    "id": "codex",
    "name": "Codex",
    "icon": {
      "brand": null,
      "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><rect x=\"1.5\" y=\"3\" width=\"21\" height=\"18\" rx=\"4.5\" fill=\"none\" stroke=\"#8b8b93\" stroke-width=\"2\"/><path d=\"M6.5 9l3.5 3-3.5 3\" fill=\"none\" stroke=\"#8b8b93\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M12.5 15.5h5\" stroke=\"#8b8b93\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>"
    },
    "command": "codex",
    "pitch": "OpenAI's coding agent. tab runs the Codex CLI with your ChatGPT sign-in or API key and streams each turn.",
    "capabilities": {
      "strict": true,
      "permission_modes": [],
      "budget_cap": false
    },
    "model_hint": "e.g. gpt-6-sol",
    "small_model": null,
    "list_models": {
      "args": [
        "app-server"
      ],
      "stdin": [
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"clientInfo\":{\"name\":\"tab\",\"version\":\"0\"}}}",
        "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\"}",
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"model/list\",\"params\":{}}"
      ],
      "format": "codex_model_list"
    },
    "install": {
      "npm": "@openai/codex",
      "unix": null,
      "windows": null
    },
    "upgrade": {
      "winget": null,
      "npm": "npm install -g @openai/codex@latest",
      "brew": "brew upgrade codex",
      "native": null
    },
    "bin_dirs": [
      ".local/bin",
      ".codex/bin"
    ]
  },
  {
    "id": "pi",
    "name": "Pi",
    "icon": {
      "brand": null,
      "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><rect x=\"1.5\" y=\"1.5\" width=\"21\" height=\"21\" rx=\"5\" fill=\"none\" stroke=\"#8b8b93\" stroke-width=\"2\"/><path d=\"M6.5 8h11M9.5 8v9M14.5 8v7.5c0 1 .6 1.5 1.5 1.5h1\" fill=\"none\" stroke=\"#8b8b93\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    },
    "command": "pi",
    "pitch": "A small, open source agent that works with most model providers. tab runs it one turn at a time and keeps each chat as a Pi session.",
    "capabilities": {
      "strict": true,
      "permission_modes": [],
      "budget_cap": false
    },
    "model_hint": "provider/model, e.g. anthropic/claude-sonnet-5-5",
    "small_model": null,
    "list_models": {
      "args": [
        "--list-models"
      ],
      "format": "provider_model_table"
    },
    "install": {
      "npm": "@earendil-works/pi-coding-agent",
      "unix": "curl -fsSL https://pi.dev/install.sh | sh",
      "windows": "irm https://pi.dev/install.ps1 | iex"
    },
    "upgrade": {
      "winget": null,
      "npm": "npm install -g @earendil-works/pi-coding-agent@latest",
      "brew": null,
      "native": "pi update"
    },
    "bin_dirs": [
      ".local/bin",
      ".pi/bin"
    ]
  }
]
