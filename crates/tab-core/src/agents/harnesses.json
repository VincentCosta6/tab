[
  {
    "id": "claude_code",
    "name": "Claude Code",
    "icon": {
      "brand": "claude"
    },
    "command": "claude",
    "pitch": "If you use Claude, tab drives the official Claude Code CLI with your own login, so your usage stays within Anthropic's terms.",
    "capabilities": {
      "strict": true,
      "permission_modes": [
        {
          "value": "default",
          "label": "Ask first",
          "help": "Asks before edits and commands"
        },
        {
          "value": "acceptEdits",
          "label": "Accept edits",
          "help": "Edits files freely, asks before commands"
        },
        {
          "value": "auto",
          "label": "Auto",
          "help": "Claude decides what's safe and asks about the rest"
        },
        {
          "value": "plan",
          "label": "Plan only",
          "help": "Reads and plans, changes nothing"
        }
      ],
      "external_server": false,
      "budget_cap": true
    },
    "model_hint": "e.g. sonnet or opus",
    "small_model": "claude-haiku-5-5",
    "models": [
      {
        "id": "claude-opus-5-5",
        "label": "Opus 5.5",
        "common": true
      },
      {
        "id": "claude-sonnet-5-5",
        "label": "Sonnet 5.5",
        "common": true
      },
      {
        "id": "claude-haiku-5-5",
        "label": "Haiku 5.5",
        "common": true
      },
      {
        "id": "claude-fable-5-1",
        "label": "Fable 5.1",
        "common": true
      },
      {
        "id": "claude-opus-5",
        "label": "Opus 5"
      },
      {
        "id": "claude-opus-4-8",
        "label": "Opus 4.8"
      }
    ],
    "list_models": null,
    "common_models": [],
    "install": {
      "npm": "@anthropic-ai/claude-code",
      "unix": "curl -fsSL https://claude.ai/install.sh | bash",
      "windows": "irm https://claude.ai/install.ps1 | iex"
    },
    "upgrade": {
      "winget": "winget upgrade Anthropic.ClaudeCode",
      "npm": "npm install -g @anthropic-ai/claude-code@latest",
      "brew": "brew upgrade --cask claude-code",
      "native": "claude update"
    },
    "bin_dirs": [
      ".local/bin",
      ".claude/local"
    ]
  },
  {
    "id": "opencode",
    "name": "OpenCode",
    "icon": {
      "brand": "opencode"
    },
    "command": "opencode",
    "pitch": "Open source and works with any model provider. tab starts its server and streams every session.",
    "capabilities": {
      "strict": true,
      "permission_modes": [],
