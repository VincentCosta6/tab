{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tab",
  "version": "0.1.0",
  "identifier": "dev.tab.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tab",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 14 }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*.mp4", "**/*.m4v", "**/*.mov", "**/*.webm", "**/*.ogv", "**/*.mp3", "**/*.m4a", "**/*.wav", "**/*.ogg", "**/*.oga", "**/*.opus", "**/*.flac", "**/*.aac", "**/*.MP4", "**/*.M4V", "**/*.MOV", "**/*.WEBM", "**/*.OGV", "**/*.MP3", "**/*.M4A", "**/*.WAV", "**/*.OGG", "**/*.OGA", "**/*.OPUS", "**/*.FLAC", "**/*.AAC"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/VincentCosta6/tab/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}