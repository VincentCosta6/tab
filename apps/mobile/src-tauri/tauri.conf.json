{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tab",
  "version": "0.1.0",
  "identifier": "dev.tab.mobile",
  "build": {
    "beforeDevCommand": "pnpm mobile:vite",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm mobile:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tab",
        "width": 390,
        "height": 844
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../../src-tauri/icons/32x32.png",
      "../../../src-tauri/icons/128x128.png",
      "../../../src-tauri/icons/128x128@2x.png",
      "../../../src-tauri/icons/icon.icns",
      "../../../src-tauri/icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "scheme": ["tabqueue"], "appLink": false }],
      "desktop": { "schemes": ["tabqueue"] }
    }
  }
}
